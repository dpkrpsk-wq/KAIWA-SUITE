  "components": [
    {
      "name": "Begleitblatt",
      "group": "Dokument",
      "summary": "Das Begleitblatt hält fest, wer welchen Teil eines Dokuments verfasst hat, und liegt neben dem Dokument."
    },
    {
      "name": "Dokumentkopf",
      "group": "Dokument",
      "summary": "Der Dokumentkopf eröffnet jede Seite eines Produkts der KAIWA SUITE mit Logo, Produktname, Produktnummer, Version, Stand und Entwurfsmarke."
    },
    {
      "name": "Fusszeile",
      "group": "Dokument",
      "summary": "Die Fußzeile trägt auf jeder Seite Produktname, Nummer, Version, Commit und Seitenzahl."
    },
    {
      "name": "Hinweisfeld",
      "group": "Dokument",
      "summary": "Das Hinweisfeld hebt eine Aussage über das Dokument hervor: einen Hinweis, eine Stelle zur Prüfung oder den Entwurfsstand."
    },
    {
      "name": "Produktlogo",
      "group": "Logo",
      "summary": "Das Produktlogo zeigt das KAIWA-Logo „K.“ als Logo mit Wortmarke und Unterzeile und als Icon, je in Fassung dunkel und hell, dazu Größenleiter und Schutzraum."
    },
    {
      "name": "Status",
      "group": "Logo",
      "summary": "Das Status-Zeichen ist das Leuchtquadrat unten rechts im KAIWA-Logo."
    },
    {
      "name": "Tabelle",
      "group": "Dokument",
      "summary": "Die Tabelle ordnet Daten in Zeilen und Spalten mit Kopfzeile in tinte, Haarlinien und fluchtenden Ziffern."
    }
  ],
